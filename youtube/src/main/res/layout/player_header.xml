<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingTop="12dp"
    android:paddingBottom="4dp">

    <TextView
        android:id="@+id/vTitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginLeft="12dp"
        android:layout_marginRight="12dp"
        android:textColor="@color/text"
        android:textSize="18sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/vMeta"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginLeft="12dp"
        android:layout_marginTop="4dp"
        android:layout_marginRight="12dp"
        android:textColor="@color/text_dim"
        android:textSize="12sp" />

    <!-- Kanal -->
    <LinearLayout
        android:id="@+id/channelRow"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:background="?attr/selectableItemBackground"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingLeft="12dp"
        android:paddingTop="4dp"
        android:paddingRight="12dp"
        android:paddingBottom="4dp">

        <ImageView
            android:id="@+id/chAvatar"
            android:layout_width="36dp"
            android:layout_height="36dp" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginLeft="10dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/chName"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:maxLines="1"
                android:textColor="@color/text"
                android:textSize="15sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/chSubs"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textColor="@color/text_dim"
                android:textSize="12sp" />
        </LinearLayout>

        <TextView
            android:id="@+id/btnSubscribe"
            android:layout_width="wrap_content"
            android:layout_height="34dp"
            android:background="@drawable/sub_bg"
            android:gravity="center"
            android:paddingLeft="16dp"
            android:paddingRight="16dp"
            android:text="Abonnieren"
            android:textColor="@color/black"
            android:textSize="14sp" />
    </LinearLayout>

    <!-- Aktionen -->
    <HorizontalScrollView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:scrollbars="none">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:paddingLeft="12dp"
            android:paddingRight="4dp">

            <TextView
                android:id="@+id/btnLike"
                style="@style/ActionButton"
                android:drawableLeft="@drawable/ic_like" />

            <TextView
                android:id="@+id/btnDownload"
                style="@style/ActionButton"
                android:drawableLeft="@drawable/ic_download"
                android:text="Download" />

            <TextView
                android:id="@+id/btnAudio"
                style="@style/ActionButton"
                android:drawableLeft="@drawable/ic_headphones"
                android:text="Nur Ton" />

            <TextView
                android:id="@+id/btnQuality"
                style="@style/ActionButton"
                android:drawableLeft="@drawable/ic_quality"
                android:text="Qualität" />

            <TextView
                android:id="@+id/btnCast"
                style="@style/ActionButton"
                android:drawableLeft="@drawable/ic_tv"
                android:text="Fernseher" />

            <TextView
                android:id="@+id/btnShare"
                style="@style/ActionButton"
                android:drawableLeft="@drawable/ic_share"
                android:text="Teilen" />
        </LinearLayout>
    </HorizontalScrollView>

    <TextView
        android:id="@+id/vDesc"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginLeft="12dp"
        android:layout_marginTop="12dp"
        android:layout_marginRight="12dp"
        android:background="@drawable/chip_bg"
        android:ellipsize="end"
        android:maxLines="3"
        android:padding="12dp"
        android:textColor="@color/text"
        android:textSize="13sp" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginLeft="12dp"
        android:layout_marginTop="16dp"
        android:layout_marginBottom="10dp"
        android:text="@string/related"
        android:textColor="@color/text"
        android:textSize="16sp"
        android:textStyle="bold" />
</LinearLayout>
